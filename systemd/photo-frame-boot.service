[Unit]
Description=Photo frame: match the schedule after boot
After=photo-frame-shutdown.service

[Service]
Type=simple
ExecStart=/bin/sh -c 'until [ -e /run/systemd/timesync/synchronized ]; do sleep 5; done; now=$$(date +%%H%%M); if [ "$$now" -ge 0600 ] && [ "$$now" -lt 2330 ]; then systemctl start photo-frame-show.service; else systemctl start photo-frame-clear.service; fi'

[Install]
WantedBy=multi-user.target
